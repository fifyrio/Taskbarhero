# TBH Tier List — environment variables
# Copy to .env (local) and set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Supabase (required) -----------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# --- App (optional) ----------------------------------------------------------
# Public site URL, used for canonical/OG URLs. Defaults to production domain.
NEXT_PUBLIC_APP_URL=https://www.taskbarhero.wiki

# Google OAuth client id for Supabase social login (optional for MVP)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics measurement id (optional)
NEXT_PUBLIC_GA_TRACKING_ID=
